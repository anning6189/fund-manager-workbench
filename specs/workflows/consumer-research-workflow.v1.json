{
  "workflow_id": "CR.WORKFLOW.RESEARCH_ORCHESTRATION.001",
  "version": "1.1.0",
  "name": "消费行业研究工作流与Agent编排",
  "status": "production_candidate_with_automatic_quality_release",
  "purpose": "把研究问题、阶段五数据路由、阶段六事实仓、阶段七模型、证据审核、反方审查与基金经理报告交付编排为可恢复、可审计的DAG。",
  "boundaries": {
    "portfolio_data": "forbidden",
    "portfolio_position_inference": "forbidden",
    "automatic_trade_instruction": "forbidden",
    "automatic_external_publication": "forbidden",
    "internal_research_release": "automatic_after_all_required_quality_gates_pass"
  },
  "roles": [
    {
      "role_id": "research_director",
      "name": "研究总控Agent",
      "responsibilities": ["规范化任务", "固定截止时间和研究边界", "生成任务DAG", "决定降级与停止条件"]
    },
    {
      "role_id": "entity_scope_agent",
      "name": "实体与口径Agent",
      "responsibilities": ["实体消歧", "证券与公司分离", "指标期间币种和报表范围统一"]
    },
    {
      "role_id": "evidence_retrieval_agent",
      "name": "事实与证据Agent",
      "responsibilities": ["阶段六时点查询", "阶段五外部任务清单", "证据定位", "来源缺口记录"]
    },
    {
      "role_id": "model_agent",
      "name": "模型Agent",
      "responsibilities": ["调用阶段七模型", "保留公式和输入血缘", "隔离事实与假设", "输出敏感性结果"]
    },
    {
      "role_id": "claim_agent",
      "name": "研究结论Agent",
      "responsibilities": ["构建逐结论图", "区分事实推断和计算", "只形成按维度的有限结论"]
    },
    {
      "role_id": "evidence_auditor",
      "name": "证据审核Agent",
      "responsibilities": ["检查截止时点", "检查逐结论引用", "检查来源等级", "阻断未来信息"]
    },
    {
      "role_id": "skeptic_agent",
      "name": "反方审查Agent",
      "responsibilities": ["提出替代解释", "列出反方证据和不可下结论事项", "设置证伪指标"]
    },
    {
      "role_id": "report_agent",
      "name": "报告交付Agent",
      "responsibilities": ["按基金经理模板组织文字报告", "生成证据索引", "将运行附录置于正文之后"]
    },
    {
      "role_id": "compliance_agent",
      "name": "合规闸门Agent",
      "responsibilities": ["阻断组合数据和仓位推断", "阻断自动交易指令", "阻断自动对外发布", "确认系统质量门状态"]
    }
  ],
  "task_graph": [
    {"task_id":"scope_guard","role_id":"research_director","lane":"control","depends_on":[],"required":true,"failure_action":"block"},
    {"task_id":"entity_resolution","role_id":"entity_scope_agent","lane":"core","depends_on":["scope_guard"],"required":true,"failure_action":"block"},
    {"task_id":"fact_retrieval","role_id":"evidence_retrieval_agent","lane":"core","depends_on":["entity_resolution"],"required":true,"failure_action":"block"},
    {"task_id":"document_retrieval","role_id":"evidence_retrieval_agent","lane":"core","depends_on":["entity_resolution"],"required":true,"failure_action":"block"},
    {"task_id":"model_execution","role_id":"model_agent","lane":"model","depends_on":["fact_retrieval"],"required":false,"failure_action":"degrade"},
    {"task_id":"claim_composition","role_id":"claim_agent","lane":"analysis","depends_on":["fact_retrieval","document_retrieval","model_execution"],"required":true,"failure_action":"block"},
    {"task_id":"evidence_audit","role_id":"evidence_auditor","lane":"quality","depends_on":["claim_composition"],"required":true,"failure_action":"block"},
    {"task_id":"skeptic_review","role_id":"skeptic_agent","lane":"quality","depends_on":["claim_composition"],"required":true,"failure_action":"block"},
    {"task_id":"report_render","role_id":"report_agent","lane":"delivery","depends_on":["evidence_audit","skeptic_review"],"required":true,"failure_action":"block"},
    {"task_id":"compliance_review","role_id":"compliance_agent","lane":"quality","depends_on":["report_render"],"required":true,"failure_action":"block"}
  ],
  "state_machine": {
    "run_states": ["planned", "running", "completed", "blocked", "failed"],
    "resume_from": ["running", "failed"],
    "idempotency_key": "package_id + package_hash",
    "package_hash_conflict": "block"
  },
  "quality_gates": [
    "cutoff_timestamp_has_timezone",
    "no_future_information",
    "fact_claim_has_direct_evidence",
    "calculation_has_formula_and_inputs",
    "material_conclusion_has_counter_analysis",
    "source_gap_is_explicit",
    "no_portfolio_or_position_fields",
    "no_automatic_trade_instruction",
    "no_automatic_external_publication",
    "all_required_quality_gates_pass_before_internal_release"
  ],
  "artifacts": [
    "execution-plan.json",
    "claim-graph.json",
    "evidence-audit.json",
    "research-report.md",
    "runtime-audit.json"
  ]
}
