# Gildata / 聚源 MCP
# 推荐二选一：
# 1) 完整 MCP URL
GILDATA_MCP_URL=https://api.gildata.com/mcp-servers/aidata-assistant-srv-tool?token=YOUR_GILDATA_MCP_TOKEN

# 2) 或只填 token，脚本会自动拼接 URL
GILDATA_MCP_TOKEN=YOUR_GILDATA_MCP_TOKEN

# 本地 LLM / cc-switch 兼容接口（可选）
LOCAL_LLM_URL=http://127.0.0.1:15721/v1/chat/completions

# 生产部署（可选）
CONSUMER_RESEARCH_HOST=0.0.0.0
CONSUMER_RESEARCH_PORT=8765
